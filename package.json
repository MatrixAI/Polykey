{
  "name": "polykey",
  "version": "2.2.0",
  "homepage": "https://polykey.com",
  "author": "Matrix AI",
  "contributors": [
    {
      "name": "Roger Qiu"
    },
    {
      "name": "Aashwin Varshney"
    },
